NEXT_PUBLIC_API_URL=https://uzbalpha.pythonanywhere.com/api
NEXT_PUBLIC_APP_HOSTNAME=bron-frontend.vercel.app
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Google OAuth: https://console.cloud.google.com/apis/credentials
# 1) Application type: Web application
# 2) Authorized JavaScript origins:
#    - http://localhost:3000
#    - https://bron-frontend.vercel.app
#    - https://your-custom-domain.com
# 3) Optional redirect flow:
#    - http://localhost:3000/auth/google/callback
#    - https://bron-frontend.vercel.app/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Telegram OAuth: numeric bot id from @BotFather (not @username)
NEXT_PUBLIC_TELEGRAM_BOT_ID=your_telegram_bot_id

# Optional full override URLs (skip building OAuth URLs in code)
NEXT_PUBLIC_GOOGLE_OAUTH_URL=
NEXT_PUBLIC_TELEGRAM_OAUTH_URL=

# Browser requests:
# - localhost / Vercel preview -> /backend proxy
# - production hostname -> direct API (CORS must allow the hostname on Django)
# Optional server-only override for the proxy target:
# API_URL=https://uzbalpha.pythonanywhere.com/api

# Vercel dashboard (required for production auth):
# - NEXT_PUBLIC_API_URL
# - NEXT_PUBLIC_GOOGLE_CLIENT_ID
# - NEXT_PUBLIC_APP_HOSTNAME (comma-separated production hostnames)
# - API_URL (optional, same as NEXT_PUBLIC_API_URL)
# Redeploy after changing NEXT_PUBLIC_* variables.
