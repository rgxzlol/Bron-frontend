NEXT_PUBLIC_API_URL=https://uzbalpha.pythonanywhere.com/api
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
# Google OAuth: https://console.cloud.google.com/apis/credentials
# 1) Application type: Web application
# 2) Authorized JavaScript origins: http://localhost:3000
# 3) Optional redirect flow: http://localhost:3000/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Telegram OAuth: numeric bot id from @BotFather (not @username)
NEXT_PUBLIC_TELEGRAM_BOT_ID=your_telegram_bot_id

# Optional full override URLs (skip building OAuth URLs in code)
NEXT_PUBLIC_GOOGLE_OAUTH_URL=
NEXT_PUBLIC_TELEGRAM_OAUTH_URL=

# Browser requests go through the /backend route proxy (src/app/backend/[...path]/route.ts).
# Optional server-only override: API_URL=https://your-api.example.com/api
